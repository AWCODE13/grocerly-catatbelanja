<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/tvTitleProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/my_account"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgAvatar"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/ic_profile"
        android:scaleType="centerCrop"
        android:clickable="true"
        android:focusable="true"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:layout_constraintTop_toBottomOf="@id/tvTitleProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <ImageView
        android:id="@+id/btnEditFoto"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_edit"
        android:background="@drawable/bg_circle"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="@id/imgAvatar"
        app:layout_constraintEnd_toEndOf="@id/imgAvatar"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/default_email"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintTop_toBottomOf="@id/imgAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:id="@+id/panelMenu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEmail"
        app:layout_constraintVertical_bias="0.0">


        <LinearLayout
            android:id="@+id/menuEmail"
            style="@style/ProfileMenuRow">

            <ImageView
                style="@style/ProfileMenuIcon"
                android:src="@drawable/ic_email"
                android:tint="?attr/colorOnSurface" />

            <TextView
                style="@style/ProfileMenuText"
                android:text="@string/change_email"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                style="@style/ProfileMenuArrow"
                android:src="@drawable/ic_arrow_right"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuPassword"
            style="@style/ProfileMenuRow">

            <ImageView
                style="@style/ProfileMenuIcon"
                android:src="@drawable/ic_lock"
                android:tint="?attr/colorOnSurface" />

            <TextView
                style="@style/ProfileMenuText"
                android:text="@string/change_password"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                style="@style/ProfileMenuArrow"
                android:src="@drawable/ic_arrow_right"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuBahasa"
            style="@style/ProfileMenuRow">

            <ImageView
                style="@style/ProfileMenuIcon"
                android:src="@drawable/ic_language"
                android:tint="?attr/colorOnSurface" />

            <TextView
                style="@style/ProfileMenuText"
                android:text="@string/choose_language"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                style="@style/ProfileMenuArrow"
                android:src="@drawable/ic_arrow_right"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuTema"
            style="@style/ProfileMenuRow">

            <ImageView
                style="@style/ProfileMenuIcon"
                android:src="@drawable/ic_theme"
                android:tint="?attr/colorOnSurface" />

            <TextView
                style="@style/ProfileMenuText"
                android:text="@string/choose_theme"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                style="@style/ProfileMenuArrow"
                android:src="@drawable/ic_arrow_right"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuLogout"
            style="@style/ProfileMenuRow">

            <ImageView
                style="@style/ProfileMenuIcon"
                android:src="@drawable/ic_logout"
                android:tint="?attr/colorOnSurface" />

            <TextView
                style="@style/ProfileMenuText"
                android:text="@string/logout"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                style="@style/ProfileMenuArrow"
                android:src="@drawable/ic_arrow_right"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
